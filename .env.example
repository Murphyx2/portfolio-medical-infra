# ------------------------------------------------------------------
# MedicalConsultations — environment template
# Copy this file to ".env" (same folder) and fill in real values.
# NEVER commit the ".env" file.
# ------------------------------------------------------------------

# --- Django ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Server-side "today" (e.g. the date in an admission number) uses this, not
# the browser's timezone -- defaults to America/Santo_Domingo if unset.
TZ=America/Santo_Domingo

# --- PostgreSQL ---
POSTGRES_DB=medicalconsultations
POSTGRES_USER=mc_admin
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
# Set a strong password for production; dev stack uses the same var.
REDIS_PASSWORD=change-this-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@cache:6379/0

# --- JWT ---
JWT_ACCESS_LIFETIME_MINUTES=15
# Refresh lifetime shortened 7d -> 3d in audit H-03; keep this in sync with
# the code default (config/settings/base.py).
JWT_REFRESH_LIFETIME_DAYS=3

# --- PII encryption (Fernet key) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_FIELD_KEY=

# --- Frontend (Vite dev proxy target; browser uses relative /api) ---
# Inside Docker this is overridden by docker-compose.override.yml to
# http://backend:8000/api — this value is only for host-side dev runs.
# Do NOT set VITE_API_BASE_URL for dev: it bakes the Docker hostname into
# the client bundle and breaks the proxy.
PROXY_TARGET=http://localhost:8000/api
