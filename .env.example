# ------------------------------------------------------------------
# MedicalConsultations — environment template
# Copy this file to ".env" (same folder) and fill in real values.
# NEVER commit the ".env" file.
# ------------------------------------------------------------------

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_DB=medicalconsultations
POSTGRES_USER=mc_admin
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://cache:6379/0

# --- JWT ---
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7

# --- PII encryption (Fernet key) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_FIELD_KEY=

# --- Frontend (Vite dev proxy target; browser uses relative /api) ---
PROXY_TARGET=http://localhost:8000/api
